NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://domofon:domofon@localhost:5432/domofon

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# SMS
SMS_PROVIDER=smsc
SMSC_LOGIN=
SMSC_PASSWORD=
OTP_TTL_SECONDS=300

# Internal API (Asterisk webhook)
INTERNAL_API_SECRET=dev-internal-secret

# YooKassa (пусто = dev-заглушка)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://domofon.example/payment-done

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=domofon

# Media
MEDIA_SERVER_URL=http://localhost:8888
MEDIA_RTSP_URL=rtsp://localhost:8554
MEDIA_PLAYBACK_URL=http://localhost:9996
S3_PUBLIC_URL=http://localhost:9000

# Push
FCM_CREDENTIALS_PATH=./secrets/fcm.json
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=ru.domofon.app
APNS_KEY_PATH=./secrets/apns.p8
