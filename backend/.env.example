NODE_ENV=development
PORT=3000

# Локальный SQLite-файл
SQLITE_PATH=./data/domofon.sqlite

# Пользователи. Формат: name:pin или name:pin:sipUser:sipPass
# sipUser/sipPass — аккаунт из infra/asterisk/pjsip.conf ([user1])
USERS=demo:1234:user1:change-me-user-pass
# Домен/IP Asterisk, который мобильный клиент использует для SIP-регистрации
SIP_DOMAIN=192.168.1.10

# Секрет, который шлёт Asterisk dialplan в заголовке X-Internal-Secret
INTERNAL_API_SECRET=dev-internal-secret

# Asterisk ARI (для открытия двери через DTMF в активном звонке)
ARI_URL=http://localhost:8088/ari
ARI_USER=domofon
ARI_PASSWORD=domofon

# Firebase Admin (только Android push). Пустой путь = заглушка с логами
FCM_CREDENTIALS_PATH=

# Sentry (опционально)
SENTRY_DSN=

# === DNAKE S213 ===
# Sip-extension панели (как зарегистрирован в Asterisk pjsip.conf)
INTERCOM_ID=panel1
INTERCOM_NAME=Подъезд 1
INTERCOM_SIP_EXT=101
# Кого набирает Asterisk при звонке с этой панели (PJSIP/<DIAL_URI>)
INTERCOM_DIAL_URI=mobiles
# Прямой RTSP с панели (LAN)
INTERCOM_RTSP_URL=rtsp://admin:admin@192.168.1.50:554/0
# HTTP API панели для открытия двери вне звонка
INTERCOM_OPEN_URL=http://192.168.1.50/cgi-bin/door_unlock
INTERCOM_OPEN_METHOD=POST
INTERCOM_OPEN_AUTH=admin:admin
# DTMF-последовательность открытия в активном звонке (стандарт DNAKE: '#')
INTERCOM_OPEN_DTMF=#
